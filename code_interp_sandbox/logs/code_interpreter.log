import pandas as pd

# Load CSV file: MOCK_DATA (1).csv
df = pd.read_csv(DATASETS_PATH + '/MOCK_DATA (1).csv')

# Group by airline_name and sum the duration_hours to find the airline with the longest total duration
total_duration_by_airline = df.groupby('airline_name')['duration_hours'].sum()

# Find the airline with the maximum total duration
longest_duration_airline = total_duration_by_airline.idxmax()
longest_duration_value = total_duration_by_airline.max()

print(f'Airline with the longest total duration: {longest_duration_airline}')
print(f'Total duration hours: {longest_duration_value}')
